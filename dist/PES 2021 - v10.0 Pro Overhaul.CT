          <ID>12</ID>
          <Description>"[ ATIVAR TUDO ] Ligar Todos os 6 Hooks Mestres v10.0 de Uma Vez"</Description>
          <Color>3B8E1E</Color>
          <VariableType>Auto Assembler Script</VariableType>
