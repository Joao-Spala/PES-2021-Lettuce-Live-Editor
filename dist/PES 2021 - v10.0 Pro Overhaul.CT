aobscanmodule(INJECT_MatchHud,PES2021.exe,49 8B F8 44 0F B6 E2 88 55 B7)
alloc(newmem_mhud,$1000,INJECT_MatchHud)

label(ret_mhud)

newmem_mhud:
  mov [ptrMatchHud],rcx
  push rax
  mov rax,[rcx+38]
  mov [ptrMatchCore],rax
  pop rax
  mov rdi,r8
  movzx r12d,dl
  jmp ret_mhud

INJECT_MatchHud:
  jmp newmem_mhud
  nop
  nop
ret_mhud:
registersymbol(INJECT_MatchHud)

aobscanmodule(INJECT_MatchClockTap,PES2021.exe,8B 44 24 40 89 44 24 40 F3 0F 10 44 24 40 48 83 C4 30 5B C3)
alloc(newmem_mclk,$1000,INJECT_MatchClockTap)

label(done_mclk)
label(ret_mclk)

newmem_mclk:
  mov eax,[rsp+40]
  push rcx
  mov rcx,[ptrMatchState]
  test rcx,rcx
  jz done_mclk
  lea rcx,[rcx+1168]
  cmp rbx,rcx
  jne done_mclk
  mov [valProtectedMatchTicks],eax
  cmp dword ptr [cfgFreezeClock],1
  jne done_mclk
  movss xmm0,[valFrozenTotalTicks]
  subss xmm0,[valProtectedMatchTicks]
  movss [rbx+0C],xmm0

done_mclk:
  pop rcx
  mov [rsp+40],eax
  jmp ret_mclk

INJECT_MatchClockTap:
  jmp newmem_mclk
  nop
  nop
  nop
ret_mclk:
registersymbol(INJECT_MatchClockTap)

[DISABLE]
INJECT_MatchHud:
  db 49 8B F8 44 0F B6 E2

unregistersymbol(INJECT_MatchHud)
dealloc(newmem_mhud)

INJECT_MatchClockTap:
  db 8B 44 24 40 89 44 24 40

unregistersymbol(INJECT_MatchClockTap)
dealloc(newmem_mclk)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>11</ID>
              <Description>"[ HOOK 6 ] Stamina Seletiva em Campo (Casa / Fora / Ambos / Pressão)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ PES 2021 v10.0 Pro — Hook 6: Stamina Seletiva em Campo (Casa / Fora / Ambos / Pressão Total) }
[ENABLE]
aobscanmodule(INJECT_SelectiveStamina,PES2021.exe,6B 45 10 64 48 8B 5C 24 50)
alloc(newmem_stam,$1000,INJECT_SelectiveStamina)

label(loop_stam)
label(found_stam)
label(is_away_stam)
label(give_100_stam)
label(drain_stam)
label(orig_stam)
label(ret_stam)

newmem_stam:
  cmp dword ptr [cfgStaminaMode],0
  je orig_stam
  mov rcx,[ptrMatchMgr]
  test rcx,rcx
  jz orig_stam
  xor edx,edx
loop_stam:
  mov rax,rdx
  add rax,F3
  lea rax,[rax+rax*4]
  cmp [rcx+rax*8],rbx
  je found_stam
  inc edx
  cmp edx,16
  jb loop_stam
  jmp orig_stam

found_stam:
  mov eax,[cfgStaminaMode]
  cmp edx,0B
  jae is_away_stam

  cmp eax,1
  je give_100_stam
  cmp eax,3
  je give_100_stam
  cmp eax,4
  je give_100_stam
  cmp eax,5
  je drain_stam
  jmp orig_stam

is_away_stam:
  cmp eax,2
  je give_100_stam
  cmp eax,3
  je give_100_stam
  cmp eax,5
  je give_100_stam
  cmp eax,4
  je drain_stam
  jmp orig_stam

give_100_stam:
  mov rbx,[rsp+50]
  mov rdi,[rsp+58]
  mov eax,64
  add rsp,30
  pop rbp
  ret

drain_stam:
  mov rbx,[rsp+50]
  mov rdi,[rsp+58]
  mov eax,05
  add rsp,30
  pop rbp
  ret

orig_stam:
  imul eax,[rbp+10],64
  mov rbx,[rsp+50]
  jmp ret_stam

INJECT_SelectiveStamina:
  jmp newmem_stam
  nop
  nop
  nop
  nop
ret_stam:
registersymbol(INJECT_SelectiveStamina)

[DISABLE]
INJECT_SelectiveStamina:
  db 6B 45 10 64 48 8B 5C 24 50

unregistersymbol(INJECT_SelectiveStamina)
dealloc(newmem_stam)
</AssemblerScript>
            </CheatEntry>
