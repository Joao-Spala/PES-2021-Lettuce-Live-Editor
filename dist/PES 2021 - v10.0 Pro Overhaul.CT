            <CheatEntry>
              <ID>6</ID>
              <Description>"[ HOOK 1 ] Captura Automática de Jogador (Edit / Elenco / Negociações)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ PES 2021 v10.0 Pro — Hook 1: Captura Automática de Jogador (Edit / Squad / Transfer) }
[ENABLE]
aobscanmodule(INJECT_ptrPlayer,PES2021.exe,CB B8 02 00 00 00 0F 1F 40 00 66 0F 1F 84 00 00 00 00 00 0F 10 02 0F 11 01)
alloc(newmem_p1,$1000,INJECT_ptrPlayer)

label(code_p1)
label(ret_p1)

newmem_p1:
  cmp eax,2
  jne code_p1
  mov [ptrPlayer],rdx

code_p1:
  movups xmm0,[rdx]
  movups [rcx],xmm0
  jmp ret_p1

INJECT_ptrPlayer+13:
  jmp newmem_p1
  nop
ret_p1:
registersymbol(INJECT_ptrPlayer)

aobscanmodule(INJECT_ptrPlayerTwo,PES2021.exe,48 8B 40 2C 48 89 02)
alloc(newmem_p2,$1000,INJECT_ptrPlayerTwo)

label(code_p2)
label(ret_p2)

newmem_p2:
  mov [ptrPlayer],rax

code_p2:
  mov rax,[rax+2C]
  mov [rdx],rax
  jmp ret_p2

INJECT_ptrPlayerTwo:
  jmp newmem_p2
  nop
  nop
ret_p2:
registersymbol(INJECT_ptrPlayerTwo)

[DISABLE]
INJECT_ptrPlayer+13:
  db 0F 10 02 0F 11 01

unregistersymbol(INJECT_ptrPlayer)
dealloc(newmem_p1)

INJECT_ptrPlayerTwo:
  db 48 8B 40 2C 48 89 02

unregistersymbol(INJECT_ptrPlayerTwo)
dealloc(newmem_p2)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>7</ID>
              <Description>"[ HOOK 2 ] Motor de Taxa de Rescisão Exata (Release Fee Override)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ PES 2021 v10.0 Pro — Hook 2: Override de Taxa de Rescisão Exata (VA 0x14156BE0C) }
[ENABLE]
aobscanmodule(INJECT_ReleaseFeeGetter,PES2021.exe,0F 29 74 24 40 48 8B DA 48 8B F1 0F 29 7C 24 30 48 8B 09)
alloc(newmem_rfee,$1000,INJECT_ReleaseFeeGetter)

label(loop_rfee)
label(next_rfee)
label(miss_rfee)
label(orig_rfee)
label(hit_rfee)
label(ret_rfee)

newmem_rfee:
  test rcx,rcx
  jz orig_rfee
  push r8
  push r9
  push rdx
  mov r8,[rcx]
  test r8,r8
  jz miss_rfee
  lea r9,[rfeeOverrideTable]
  xor edx,edx
loop_rfee:
  cmp dword ptr [r9+0C],1
  jne next_rfee
  cmp [r9],r8
  je hit_rfee
next_rfee:
  add r9,10
  inc edx
  cmp edx,40
  jb loop_rfee

miss_rfee:
  pop rdx
  pop r9
  pop r8
orig_rfee:
  movaps [rsp+40],xmm6
  jmp ret_rfee

hit_rfee:
  mov eax,[r9+08]
  pop rdx
  pop r9
  pop r8
  mov rbx,[rsp+70]
  add rsp,50
  pop rdi
  pop rsi
  pop rbp
  ret

INJECT_ReleaseFeeGetter:
  jmp newmem_rfee
ret_rfee:
registersymbol(INJECT_ReleaseFeeGetter)

[DISABLE]
INJECT_ReleaseFeeGetter:
  db 0F 29 74 24 40

unregistersymbol(INJECT_ReleaseFeeGetter)
dealloc(newmem_rfee)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>8</ID>
              <Description>"[ HOOK 3 ] Multiplicador Universal de Sub-XP (Treino ML, Base &amp; BAL)"</Description>
