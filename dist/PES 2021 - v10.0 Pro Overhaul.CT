[ENABLE]
aobscanmodule(INJECT_TrainingXpAdder,PES2021.exe,45 8B C8 83 FA 6C 0F 8D 1E 01 00 00)
alloc(newmem_txp,$1000,INJECT_TrainingXpAdder)

label(check_clamp_txp)
label(orig_txp)
label(ret_txp)

newmem_txp:
  mov r9d,[cfgTrainingMultMode]
  test r9d,r9d
  jz orig_txp
  test r8d,r8d
  jle orig_txp
  cmp r9d,1
  jne @f
  imul r8d,r8d,2
  jmp check_clamp_txp
@@:
  cmp r9d,2
  jne @f
  imul r8d,r8d,5
  jmp check_clamp_txp
@@:
  cmp r9d,3
  jne @f
  imul r8d,r8d,0A
  jmp check_clamp_txp
@@:
  cmp r9d,4
  jne @f
  imul r8d,r8d,32
  jmp check_clamp_txp
@@:
  mov r8d,2710

check_clamp_txp:
  cmp r8d,2710
  jle orig_txp
  mov r8d,2710

orig_txp:
  mov r9d,r8d
  cmp edx,6C
  jmp ret_txp

INJECT_TrainingXpAdder:
  jmp newmem_txp
  nop
ret_txp:
registersymbol(INJECT_TrainingXpAdder)

[DISABLE]
INJECT_TrainingXpAdder:
  db 45 8B C8 83 FA 6C

unregistersymbol(INJECT_TrainingXpAdder)
dealloc(newmem_txp)
</AssemblerScript>
            </CheatEntry>
