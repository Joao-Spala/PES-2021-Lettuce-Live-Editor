              <Description>"[ PRESET ] Tornar LENDA (Nível 3)"</Description>
              <Color>0066CC</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
PES10.asyncActionButton(memrec, function()
  local p=PES10.getSelectedPlayerOrWarn(); if p~=0 then PES10.setTeamRole(p,19,3); PES10.toast(PES10.T('Team Role definido: Lenda (Nv.3)!','Team Role set: Legend (Lv.3)!')) end
end)
{$asm}
[DISABLE]
</AssemblerScript>
