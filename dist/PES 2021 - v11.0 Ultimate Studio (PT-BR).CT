          <ID>117</ID>
          <Description>"5. Posição de Origem &amp; 13 Posições Jogáveis (C / B / A)"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1" />
          <GroupHeader>1</GroupHeader>
          <Color>807A00</Color>
          <CheatEntries>
            <CheatEntry>
              <ID>118</ID>
              <Description>"[ 1-CLIQUE ] Promover Todas as Secundárias ('B' → 'A')"</Description>
              <Color>3B8E1E</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
PES10.asyncActionButton(memrec, function()
  local p=PES10.getSelectedPlayerOrWarn(); if p~=0 then local n=PES10.promoteSecondaryPositionsToA(p); PES10.toast(string.format(PES10.T('%d secundária(s) promovida(s) p/ A!','%d secondary position(s) promoted to A!'), n)) end
end)
{$asm}
[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>119</ID>
              <Description>"[ +1 OVR POSIÇÃO ] Subir +1 OVR em Posição Específica..."</Description>
              <Color>CC5500</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
PES10.asyncActionButton(memrec, function()
  PES10.promptTargetPositionOVRPlusOne()
end)
{$asm}
[DISABLE]
</AssemblerScript>
