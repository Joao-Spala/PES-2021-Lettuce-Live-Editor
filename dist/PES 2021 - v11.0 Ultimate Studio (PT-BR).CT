  [3]  = { pt = "Jogador de Equipe",       en = "Team Player" },
  [4]  = { pt = "Armador",                 en = "Playmaker" },
  [5]  = { pt = "Estrela",                 en = "Star Player" },
  [6]  = { pt = "Líder",                   en = "Leader" },
  [7]  = { pt = "General",                 en = "General" },
  [8]  = { pt = "Criador",                 en = "Creator" },
  [9]  = { pt = "Maestro",                 en = "Maestro" },
