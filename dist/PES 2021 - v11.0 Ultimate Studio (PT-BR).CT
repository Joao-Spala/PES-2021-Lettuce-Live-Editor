        tag_pt="+50M", tag_en="+50M",
        title_pt="+ 50 Milhões (Transferências)", title_en="+ 50 Million (Transfer Budget)",
        sub_pt="Adiciona +50M imediatos ao caixa de contratações", sub_en="Instantly adds +50M to your club transfer funds",
